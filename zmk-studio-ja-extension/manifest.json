{
  "manifest_version": 3,
  "name": "ZMK Studio Japanese",
  "version": "1.0.0",
  "description": "ZMK StudioのUIを日本語に翻訳します",
  "permissions": [],
  "host_permissions": [
    "https://zmk.studio/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://zmk.studio/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
